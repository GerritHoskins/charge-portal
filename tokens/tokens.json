{
  "$description": "Single source of truth for design tokens. `npm run tokens` generates app/assets/css/tokens.css from this file; `npm run tokens -- --check` (part of `npm run check`) fails if the CSS was edited by hand. Keys are the CSS custom property names. A Figma Variables / Tokens Studio export is meant to be transformed into this shape; that sync is not implemented.",
  "base": {
    "--color-bg": "#ffffff",
    "--color-surface": "#f5f7fa",
    "--color-text": "#1b2430",
    "--color-text-muted": "#4a5568",
    "--color-border": "#c9d1db",
    "--color-brand": "#0b5cd5",
    "--color-brand-contrast": "#ffffff",
    "--color-focus": "#b45309",
    "--color-error": "#b42318",
    "--status-available-bg": "#d8f3e3",
    "--status-available-fg": "#0b4a26",
    "--status-charging-bg": "#dbe8ff",
    "--status-charging-fg": "#0b3a8c",
    "--status-faulted-bg": "#fde0e0",
    "--status-faulted-fg": "#7a1111",
    "--status-offline-bg": "#e5e7eb",
    "--status-offline-fg": "#2d3340",
    "--space-1": "0.25rem",
    "--space-2": "0.5rem",
    "--space-3": "1rem",
    "--space-4": "1.5rem",
    "--radius": "0.5rem",
    "--font-sans": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
  },
  "tenants": {
    "stadtwerke-demo": { "--color-brand": "#0a6b4f", "--color-surface": "#f2f8f5" },
    "fleet-demo": { "--color-brand": "#6d28d9", "--color-surface": "#f6f3fc" }
  }
}
