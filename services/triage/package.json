{
  "name": "@charge-portal/triage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fault triage service: NestJS + GraphQL + PostgreSQL/TypeORM (ADR 0009). Internal; only the Nuxt BFF talks to it.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "vite build && concurrently -k -n build,node \"vite build --watch\" \"node --watch dist/main.js\"",
    "build": "vite build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "vite build && node dist/seed.js seed",
    "seed:reset": "vite build && node dist/seed.js reset",
    "e2e:serve": "vite build && node dist/seed.js prepare && node dist/main.js",
    "migration:run": "vite build && typeorm migration:run -d dist/data-source.js",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:integration"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@apollo/server": "^5.5.1",
    "@charge-portal/fault-taxonomy": "*",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/typeorm": "^11.0.3",
    "graphql": "^16.14.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
