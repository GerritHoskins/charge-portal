{
  // Typecheck only (noEmit): vite + SWC produce the runtime JavaScript. SWC needs no `isolatedModules`
  // flag, but `import type` is NOT used for classes injected via constructor/decorators (metadata).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src", "test", "*.config.ts"]
}
