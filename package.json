{
  "name": "charge-portal-nuxt",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n legacy,nuxt \"npm:legacy\" \"nuxt dev --port 3000\"",
    "legacy": "node legacy/server.mjs",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "check:workspaces": "npm run check --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "hooks:install": "simple-git-hooks",
    "test:coverage": "vitest run --coverage",
    "test:contract": "playwright test --project=contract",
    "migration:status": "node scripts/migration-status.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run check:workspaces && npm run tokens -- --check && npm run migration:status -- --check && npm run test:coverage && npm run test:e2e && npm run budget",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "budget": "npm run build && node scripts/check-bundle-size.mjs && node scripts/check-route-budget.mjs",
    "lighthouse": "npm run build && node scripts/lighthouse.mjs",
    "lighthouse:shop": "npm run build && node scripts/lighthouse.mjs --config lighthouserc.shop.cjs --public",
    "rum:sample": "node scripts/rum-sample.mjs",
    "simulate:telemetry": "node scripts/telemetry-simulator.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "nuxt": "^4.6.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "simple-git-hooks": "^2.14.0",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "@apollo/server-plugin-landing-page-graphql-playground": {
      "@apollo/server": "^5.5.1"
    }
  }
}
